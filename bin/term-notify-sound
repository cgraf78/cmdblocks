#!/usr/bin/env bash
# term-notify-sound — Play a terminal notification sound.
# Emits one standard bell (BEL), rendered by the terminal client. Falls back to
# the current tmux pane's pty when /dev/tty is unavailable.

set -u

send_tty_notify() {
  # BEL crosses local and remote ptys; the client owns sound playback.
  printf '\a'
}

notify_tty="${TERM_NOTIFY_TTY:-/dev/tty}"
if (send_tty_notify >>"$notify_tty") 2>/dev/null; then
  : # sent directly
elif [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
  pane_tty=$(tmux display-message -t "${TMUX_PANE}" -p '#{pane_tty}' 2>/dev/null)
  if [ -n "$pane_tty" ]; then
    send_tty_notify >>"$pane_tty" 2>/dev/null || true
  fi
fi
