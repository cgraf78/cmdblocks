#!/usr/bin/env bash
# Lint the reviewed program rows from the shared CI inventory.

set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
inventory_file="$root/.github/shellcheck-files.txt"

shell_files=()
while IFS= read -r line || [[ -n "$line" ]]; do
  [[ -n "$line" && "$line" != '#'* ]] || continue
  case "$line" in
    *$'\t'*) ;;
    *)
      printf 'shellcheck-test: malformed inventory record\n' >&2
      exit 1
      ;;
  esac
  type="${line%%$'\t'*}"
  path="${line#*$'\t'}"
  case "$path" in
    '' | . | .. | /* | ./* | ../* | */. | */.. | */../* | */./* | */ | *//* | *$'\n'* | *$'\t'*)
      printf 'shellcheck-test: invalid inventory path: %s\n' "$path" >&2
      exit 1
      ;;
  esac
  if [[ -z "$type" ]]; then
    printf 'shellcheck-test: malformed inventory record\n' >&2
    exit 1
  fi
  case "$type" in
    program) shell_files+=("$path") ;;
    fixture) ;;
    *)
      printf 'shellcheck-test: unknown inventory type: %s\n' "$type" >&2
      exit 1
      ;;
  esac
done <"$inventory_file"

if [[ "${#shell_files[@]}" -eq 0 ]]; then
  printf 'shellcheck-test: inventory includes no programs\n' >&2
  exit 1
fi

if [[ "${CMDBLOCKS_SKIP_SHELLCHECK:-0}" = 1 ]]; then
  printf 'shellcheck-test: delegated to shared CI\n'
  exit 0
fi

if ! command -v shellcheck >/dev/null 2>&1; then
  printf 'shellcheck-test: shellcheck is required\n' >&2
  exit 1
fi

absolute_files=()
for path in "${shell_files[@]+"${shell_files[@]}"}"; do
  absolute_files+=("$root/$path")
done

shellcheck -x -P SCRIPTDIR "${absolute_files[@]+"${absolute_files[@]}"}"

printf 'shellcheck-test: ok\n'
