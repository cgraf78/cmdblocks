#!/usr/bin/env bash
# Verify shared ShellCheck delegation without weakening the local test entrypoint.

set -uo pipefail
export NO_COLOR=1

test_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
root="$(cd -- "$test_dir/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$test_dir/helpers.sh"

echo "=== CI contracts ==="

lock_file="$root/.github/cgraf78-actions.lock"
actions_sha=missing-lock
if [[ -f "$lock_file" && ! -L "$lock_file" ]]; then
  actions_sha=$(tr -d '\n' <"$lock_file")
  if [[ "$actions_sha" =~ ^[0-9a-f]{40}$ ]] &&
    [[ $(wc -l <"$lock_file") -eq 1 ]]; then
    _pass "workflow: has one canonical cgraf78/actions lock"
  else
    _fail "workflow: has one canonical cgraf78/actions lock"
  fi
else
  _fail "workflow: has one canonical cgraf78/actions lock"
fi

workflow_path="$root/.github/workflows/test.yml"
workflow=$(cat "$workflow_path")
retry_workflow=$(cat "$root/.github/workflows/retry-infrastructure.yml")
actions_sync_job=$(awk '
  /^  actions-sync:$/ { in_sync = 1 }
  in_sync && /^  [^ ]/ && $0 != "  actions-sync:" { exit }
  in_sync { print }
' "$workflow_path")
_assert_contains "workflow: pushes only the maintained main branch" \
  'branches: [main]' "$workflow"
_assert_contains "workflow: pins the locked shared ShellCheck revision" \
  "cgraf78/actions/.github/workflows/shell-ci.yml@$actions_sha" "$workflow"
_assert_contains "workflow: has the required actions synchronization job" \
  'actions-sync:' "$actions_sync_job"
_assert_contains "workflow: gives the synchronization job its stable check name" \
  'name: cgraf78/actions sync' "$actions_sync_job"
_assert_contains "workflow: synchronization job uses the standard runner" \
  'runs-on: ubuntu-24.04' "$actions_sync_job"
_assert_contains "workflow: synchronization job has read-only contents access" \
  'contents: read' "$actions_sync_job"
if [[ $(printf '%s\n' "$actions_sync_job" | grep -Ec \
  '^[[:space:]]+- uses:[[:space:]]+actions/checkout@[0-9a-f]{40}([[:space:]]+#[^[:cntrl:]]*)?$') -eq 1 ]]; then
  _pass "workflow: synchronization checkout is immutable"
else
  _fail "workflow: synchronization checkout is immutable"
fi
_assert_contains "workflow: synchronization checkout does not persist credentials" \
  'persist-credentials: false' "$actions_sync_job"
_assert_contains "workflow: verifier uses the locked actions revision" \
  "cgraf78/actions/.github/actions/verify-consumer-sync@$actions_sha" \
  "$actions_sync_job"
_assert_contains "retry: uses the locked actions revision" \
  "cgraf78/actions/.github/actions/infra-retry@$actions_sha" "$retry_workflow"
_assert_contains "workflow: delegates the typed shell inventory" \
  'shellcheck-inventory-path: .github/shellcheck-files.txt' "$workflow"
_assert_contains "workflow: runtime installs only behavioral prerequisites" \
  'profiles: base' "$workflow"
_assert_not_contains "workflow: runtime does not reinstall ShellCheck" \
  'profiles: base,shellcheck' "$workflow"
_assert_contains "workflow: runtime delegates only ShellCheck execution" \
  'test-command: CMDBLOCKS_SKIP_SHELLCHECK=1 test/cmdblocks-test' "$workflow"

mock_bin=$(_tmpdir)
shellcheck_log="$mock_bin/shellcheck.log"
cat >"$mock_bin/shellcheck" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$@" >"$CMDBLOCKS_SHELLCHECK_LOG"
EOF
chmod +x "$mock_bin/shellcheck"

env -u CMDBLOCKS_SKIP_SHELLCHECK \
  CMDBLOCKS_SHELLCHECK_LOG="$shellcheck_log" PATH="$mock_bin:$PATH" \
  "$test_dir/suites/shellcheck-test" >/dev/null
local_status=$?
_assert_exit "runner: unset local default succeeds" 0 "$local_status"
_assert_file_exists "runner: unset local default executes ShellCheck" \
  "$shellcheck_log"
_assert_contains "runner: local lint consumes inventory programs" \
  "$root/bin/term-notify-sound" "$(cat "$shellcheck_log")"

rm "$shellcheck_log"
delegated_output=$(CMDBLOCKS_SKIP_SHELLCHECK=1 \
  CMDBLOCKS_SHELLCHECK_LOG="$shellcheck_log" PATH="$mock_bin:$PATH" \
  "$test_dir/suites/shellcheck-test" 2>&1)
delegated_status=$?
_assert_exit "runner: delegated mode succeeds" 0 "$delegated_status"
_assert_contains "runner: delegated mode reports shared ownership" \
  "delegated to shared CI" "$delegated_output"
_assert_file_missing "runner: delegated CI skips only ShellCheck execution" \
  "$shellcheck_log"

_test_summary
