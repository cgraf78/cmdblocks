#!/usr/bin/env bash
# Verify that PATH-visible command-block helpers have manual pages.

set -o pipefail
export NO_COLOR=1

CMDBLOCKS_TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
CMDBLOCKS_REPO_ROOT="$(cd -- "$CMDBLOCKS_TEST_DIR/.." && pwd -P)"

# shellcheck source=../helpers.sh
. "$CMDBLOCKS_TEST_DIR/helpers.sh"

echo "=== cmdblocks: manpages ==="

for command in tmux-copy-last-output term-notify-sound; do
  page="$CMDBLOCKS_REPO_ROOT/man/man1/$command.1"
  _assert_file_exists "manpage exists: $command" "$page"
  content=$(cat "$page")
  _assert_contains "manpage NAME section: $command" ".SH NAME" "$content"
  _assert_contains "manpage names command: $command" "$command \\" "$content"
done

_test_summary
